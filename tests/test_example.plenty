# The values examples/meeting.plenty prints, as shown in README.md.
import std.test
import tz
from std.fmt import FormatError

def test_meeting_example() -> Result[(), std.test.TestError | tz.TzError | FormatError | AllocError]:
    new_york = tz.zone("America/New_York")?
    london = tz.zone("Europe/London")?
    meeting = tz.datetime(2024, 3, 9, 9, 30)?.to_zoned(&new_york, tz.Disambiguation.Reject)?
    next_week = meeting.checked_add(&tz.span(weeks=1), tz.Disambiguation.Reject)?
    std.test.equal(&f"{next_week}"?, &"2024-03-16T09:30:00-04:00[America/New_York]")?
    std.test.equal(&f"{next_week.in_zone(&london)?}"?, &"2024-03-16T13:30:00+00:00[Europe/London]")?
    std.test.equal(&meeting.span_until(&next_week).hours(), &167)
