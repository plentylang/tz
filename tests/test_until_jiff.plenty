# Disambiguation.Compatible, the resolution jiff always uses.
import std.test
import tz

type Problem = std.test.TestError | AllocError | tz.TzError

def fields(span: &tz.Span) -> (i64, i64, i64, i64, i64, i64, i64, i64):
    (span.years(), span.months(), span.weeks(), span.days(), span.hours(), span.minutes(), span.seconds(), span.nanoseconds())

def until(start: &str, end: &str, largest: tz.Unit, expected: (i64, i64, i64, i64, i64, i64, i64, i64)) -> Result[(), Problem]:
    first = tz.parse_zoned(start)?
    second = tz.parse_zoned(end)?
    std.test.equal(&fields(&first.until(&second, largest, tz.Disambiguation.Compatible)?), &expected)

def since(start: &str, end: &str, largest: tz.Unit, expected: (i64, i64, i64, i64, i64, i64, i64, i64)) -> Result[(), Problem]:
    first = tz.parse_zoned(start)?
    second = tz.parse_zoned(end)?
    std.test.equal(&fields(&first.since(&second, largest, tz.Disambiguation.Compatible)?), &expected)

